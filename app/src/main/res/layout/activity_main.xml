<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#040404"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Title -->

        <!-- Header / Banner -->

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="370dp"
            android:layout_height="244dp"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:src="@drawable/screenshot_2026_10_30_at_1_05_09pm" />

        <!-- Subtitle under logo -->

        <!-- Card: Target Configuration -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="37dp"
            android:background="#0D0D0D"
            android:fontFamily="@font/orbitron"
            android:gravity="center"
            android:text="// Android Radio &amp; Telephony Exploit //"
            android:textAlignment="center"
            android:textColor="#F1F6F6"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="93dp"
            android:background="#040404"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="269dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:layout_marginLeft="27dp"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.1"
                android:text="TARGET_PHONE_NUMBER"
                android:textAlignment="center"
                android:textColor="#31F2F6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/phoneInput"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="#717875"
                android:fontFamily="@font/orbitron"
                android:gravity="center_horizontal"
                android:hint="e.g. 0401234567"
                android:inputType="phone"
                android:letterSpacing="0.2"
                android:textColor="#FFFFFF"
                android:textColorHint="#717875"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card: SIM / Interface Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="101dp"
            android:background="#050505"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="202dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="20dp"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.1"
                android:text="TRANSMITTER_SIM"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="#31F2F6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/senderSpinner"
                android:layout_width="match_parent"
                android:layout_height="51dp"
                android:backgroundTint="#1EE0E9" />
        </LinearLayout>

        <!-- Card: Attack Profile / Payload Customizer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="142dp"
            android:background="#020202"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="309dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="30dp"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.1"
                android:text="ATTACK_PROFILE / PAYLOAD"
                android:textAlignment="center"
                android:textColor="#31F2F6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/profileSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#2BB8BF" />

            <EditText
                android:id="@+id/customHexInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#616865"
                android:fontFamily="@font/orbitron"
                android:gravity="center_horizontal"
                android:hint="Custom Hex (Optional): 01 06 88 80 00 BE"
                android:inputType="text"
                android:letterSpacing="0.1"
                android:textColor="#FFFFFF"
                android:textColorHint="#757780"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Side-by-Side Pill Buttons Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="5dp"
            android:background="#050505"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/repeatBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/pill_button_background_secondary"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.15"
                android:text="REPEAT"
                android:textAlignment="center"
                android:textColor="#2CCDD0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/sendBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/pill_button_background"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.15"
                android:text="EXECUTE"
                android:textAlignment="center"
                android:textColor="#FBFAFA"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Console / Telemetry & Delivery Log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="148dp"
            android:layout_marginBottom="16dp"
            android:background="#090909"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="463dp"
                android:layout_height="123dp"
                android:background="#050505"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:lineSpacingExtra="4dp"
                android:padding="2dp"
                android:scrollbars="vertical"
                android:text="System initialized. Awaiting user command..."
                android:textColor="#2FF253"
                android:textIsSelectable="true"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/pill_button_background_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/pill_button_background_secondary" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/pill_button_background_secondary" />

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/pill_button_background_secondary" />

    </LinearLayout>
</ScrollView>
